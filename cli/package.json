{
  "name": "agentkitx",
  "version": "0.1.2",
  "description": "Interactive CLI to install portable Agent Skills for Cursor, Claude Code, Copilot, and more.",
  "type": "module",
  "bin": {
    "agentkitx": "bin/agentkitx.js"
  },
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "sync-assets": "node scripts/sync-assets.mjs",
    "prepublishOnly": "npm run sync-assets && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "agent-skills",
    "cursor",
    "claude-code",
    "copilot",
    "windsurf",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.5.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
